# 服务端口
PORT=3000
HOST=0.0.0.0

# 数据库路径（相对路径即可；容器内 WORKDIR 为 /app，等价于 /app/data/caiwu.db）
# 注意：不要在本机开发时填 /app/... 绝对路径，会因为没有 / 的写权限而启动失败
DATABASE_PATH=./data/caiwu.db

# JWT 密钥（请修改为随机字符串）
JWT_SECRET=please-change-this-secret

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# DeepSeek AI 配置（文字 / 语音转写文本解析）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼（DashScope）图片识别配置（qwen3-vl-flash 解析消费小票/截图）
# 也可在管理后台「系统设置 → 图片识别」里填，设置项 vision.* 会覆盖这里
# 推荐用业务空间专属域名（百炼控制台 → API Key 管理 复制 API Host），格式：
#   https://{WorkspaceId}.{region}.maas.aliyuncs.com/compatible-mode/v1
# 旧域名 dashscope.aliyuncs.com 自 2026-09-30 起不再支持新特性（仍可调用）
# 注意：专属域名只能访问该业务空间，API Key 必须属于同一业务空间
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VL_MODEL=qwen3-vl-flash

# OpenILink Hub 配置（微信机器人）
HUB_URL=
BASE_URL=
